<?xml version='1.0' encoding='utf-8'?>
<widget id="com.nokia.snake.reimagined" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Nokia Snake</name>
    <description>A premium, modern reimagining of the classic Nokia Snake game — 50 levels, touch controls, full screen.</description>
    <author email="you@example.com" href="https://github.com/">Nokia Snake</author>

    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <preference name="Fullscreen" value="true" />
    <preference name="Orientation" value="portrait" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackgroundColor" value="0xFF070B12" />
    <preference name="AndroidWindowSplashScreenBackground" value="#070B12" />
    <preference name="StatusBarOverlaysWebView" value="true" />
    <preference name="StatusBarBackgroundColor" value="#00000000" />
    <preference name="StatusBarStyle" value="lightcontent" />
    <preference name="AndroidXEnabled" value="true" />
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="34" />

    <platform name="android">
        <allow-intent href="market:*" />
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application" xmlns:android="http://schemas.android.com/apk/res/android">
            <application android:usesCleartextTraffic="true" android:hardwareAccelerated="true" />
        </edit-config>
    </platform>
</widget>
